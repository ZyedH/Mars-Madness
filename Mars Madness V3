  <div class="die"><div class="dief" id="dief" aria-live="polite">⚀</div><div><button class="primary" id="rollBtn">Roll the die</button><div id="pos"></div></div></div>
  <div id="board"></div>
  <div class="manual" id="entry"><input id="code" type="text" inputmode="numeric" placeholder="Card number (1–30)" aria-label="Card number"><button id="goBtn">Show scenario</button></div>
  <div class="status"><b id="stitle"></b><span id="smsg"></span></div>
  <div id="card"></div>
  <details class="piles" id="piles"><summary id="psum"></summary><div id="pbody"></div></details>
  <div class="ovr"><h2>Manual override: Resource settings</h2><p id="ovrnote"></p></div>
  <div class="teams" id="teams"></div>
  <button class="reset" id="resetBtn">New mission</button>
</div>
</main>
<div class="end" id="end" role="dialog" aria-modal="true" aria-label="Mission result"><div class="endbox" id="endbox"></div></div>

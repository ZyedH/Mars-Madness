<main>
<section class="ts" id="titlescreen">
  <div class="planet" aria-hidden="true"></div><h1>Mars Madness</h1>
  <p>Thirty days on Mars. Every decision costs something.</p>
  <div class="modes" id="modes"></div><div id="setup" style="width:100%"></div>
  <button class="primary" id="startBtn" disabled>Start mission</button>
  <button id="contBtn" style="display:none;width:100%">Continue mission</button>
</section>
<div id="play" style="display:none">

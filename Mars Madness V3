const RES=[["oxygen","Oxygen","OXYGEN CRITICAL!"],["water","Water","WATER CRITICAL!"],["food","Food","FOOD CRITICAL!"],["power","Power","POWER CRITICAL!"],["safety","Safety","SAFETY CRITICAL!"],["crew","Crew health","CREW HEALTH CRITICAL!"]];
const shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const fresh=()=>({pick:null,setup:{nt:1,sizes:[1,1]},mode:null,started:false,over:false,winner:null,teams:[],turn:0,deck:[],num:0,picked:true,outcome:"",title:"",msg:"",last:0});
let S=fresh();
try{const t=localStorage.getItem("marsMadness");if(t)S=Object.assign(fresh(),JSON.parse(t))}catch(e){}
const $=x=>document.getElementById(x);
const save=()=>{try{localStorage.setItem("marsMadness",JSON.stringify(S))}catch(e){}};
const T=()=>S.teams[S.turn];
const locked=()=>S.teams.some(t=>t.day>=1);
const cellOf=p=>p===0?0:((p-1)%30)+1;
const ico=n=>ICO[ix(n)];
const fx=e=>RES.filter(([k])=>e[k]).map(([k,n])=>(e[k]>0?'+':'−')+Math.abs(e[k])+' '+n).join(' · ');
function cardHTML(n){const [e,c]=ico(n);return '<div class="card" style="--c:'+c+'"><div class="ctop"><span class="cn">Card '+n+(n>=23?' · Good news':isQ(n)?' · Quiet day':'')+'</span><span class="ci" aria-hidden="true">'+e+'</span></div><div class="cb"><h3>'+CARDS[n-1]+'</h3><p>'+DESC[ix(n)]+'</p></div></div>'}
function miniHTML(n){const [e,c]=ico(n);return '<div class="mini" style="--c:'+c+'" title="Card '+n+': '+CARDS[n-1]+'"><b>'+n+'</b><span>'+e+'</span></div>'}
function choiceHTML(){
  if(S.picked)return S.outcome?'<div class="outcome">'+S.outcome+'</div>':'';
  const set=CHOICES[ix(S.num)];
  return '<div class="lesson"><h3>What does the crew do?</h3>'+set.map((o,k)=>'<button class="choice" data-c="'+k+'">'+o[0]+'<small>'+fx(o[1])+'</small></button>').join('')+'</div>';
}
function tokens(s){let h="";S.teams.forEach((t,i)=>t.pos.forEach((p,m)=>{if(cellOf(p)===s)h+='<span class="tok'+(i===S.turn&&m===t.mi?' on':'')+'" style="background:'+TC[i]+'" title="'+t.name+'">'+"AB"[i]+'</span>'}));return h}
function boardHTML(){
  let h='<div class="start">Start '+tokens(0)+'</div><div class="grid">';
  for(let s=1;s<=30;s++){const r=Math.floor((s-1)/6),c=(s-1)%6,col=r%2?5-c:c;
    h+='<div class="cell" style="grid-row:'+(r+1)+';grid-column:'+(col+1)+'"><i>'+s+'</i>'+tokens(s)+'</div>'}
  return h+'</div>';
}
function teamHTML(t,i){
  const off=locked()||S.over;
  let h='<section class="team'+(i===S.turn&&!S.over?' act':'')+(t.out?' out':'')+'" style="--tc:'+TC[i]+'"><div class="th"><h2>'+t.name+'</h2><span>'+(t.out?'OUT · '+t.why:'Day '+t.day+' / 30')+' · '+t.size+(t.size>1?' members':' member')+'</span></div><div class="track"><i style="width:'+(t.day/30*100)+'%"></i></div>';
  RES.forEach(([k,n,w])=>{const v=t.r[k],low=v<=t.max*0.2;
    h+='<div class="rr'+(low?' low':'')+'"><div class="rl"><span>'+n+'</span><b>'+v+' / '+t.max+'</b></div><div class="bar"><i style="width:'+(v/t.max*100)+'%"></i></div><div class="steps">'+
    [-10,-5,5,10].map(d=>'<button data-t="'+i+'" data-k="'+k+'" data-d="'+d+'" aria-label="'+t.name+' '+n+(d>0?' plus ':' minus ')+Math.abs(d)+'"'+(off?' disabled':'')+'>'+(d>0?'+':'−')+Math.abs(d)+'</button>').join('')+'</div>'+(low?'<div class="warn">'+w+'</div>':'')+'</div>'});
  return h+'</section>';
}
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let NASA={};
const NMAP={"POWER PROBLEMS":"sun","EARTH DOESN’T ANSWER IN AN EMERGENCY":"sun","COMMUNICATION DELAYS":"sun","EXTREME TEMPERATURES IN SPACE":"sun","SUPPLY DROP FROM EARTH":"sun","EARTH LINK OPENS":"sun","QUIET SUN":"sun","METEORITE DAMAGE":"neo","EXTREME TEMPERATURES ON MARS":"insight","SOLAR PANELS WORKING WELL":"insight","ALL SYSTEMS NORMAL":"apod","GOOD NEWS FROM HOME":"apod"};
const frank=c=>{const m=/^([A-Z])(\d+(?:\.\d+)?)/.exec(c||"");return m?"ABCMX".indexOf(m[1])*100+parseFloat(m[2]):-1};
function nasaBox(n){
  const d=NASA[NMAP[CARDS[n-1]]];if(!d)return"";
  return '<div class="nasa"><h3>Real NASA data · '+d.head+'</h3><p>'+esc(d.text)+'</p>'+(/^https:/.test(d.img||"")?'<img src="'+esc(d.img)+'" alt="'+esc(d.alt)+'" onerror="this.remove()">':'')+'<small>'+d.src+'</small></div>';
}
async function nj(u){const r=await fetch(u);if(!r.ok)throw new Error("HTTP "+r.status);return r.json()}
async function loadNasa(){
  const B="https://api.nasa.gov/",q="&api_key=DEMO_KEY";
  const iso=d=>new Date(Date.now()-d*864e5).toISOString().slice(0,10),dr="startDate="+iso(30)+"&endDate="+iso(0);
  const R=await Promise.allSettled([nj(B+"insight_weather/?feedtype=json&ver=1.0"+q),nj(B+"neo/rest/v1/feed?start_date="+iso(6)+"&end_date="+iso(0)+q),nj(B+"DONKI/FLR?"+dr+q),nj(B+"DONKI/GST?"+dr+q),nj(B+"planetary/apod?thumbs=true"+q)]);
  const [ins,neo,flr,gst,apod]=R,v=x=>x.status==="fulfilled"?x.value:null,N={};
  try{const j=v(ins),sk=j&&j.sol_keys||[],sol=sk[sk.length-1],s=j&&j[sol];
    if(s&&s.AT)N.insight={head:"InSight Mars weather",text:"On sol "+sol+(s.Season?" ("+s.Season+")":"")+", InSight measured air temperatures from "+Math.round(s.AT.mn)+" °C to "+Math.round(s.AT.mx)+" °C"+(s.PRE?", with air pressure near "+Math.round(s.PRE.av)+" Pa":"")+". Crews plan every outdoor job around swings like this. (InSight stopped working in 2022, so these are its last recorded sols.)",src:"api.nasa.gov · InSight: Mars Weather"}}catch(e){}
  try{const j=v(neo),all=[].concat(...Object.values(j&&j.near_earth_objects||{}));
    if(all.length){const dm=o=>o.estimated_diameter.meters.estimated_diameter_max,km=o=>+o.close_approach_data[0].miss_distance.kilometers;
      const big=all.reduce((a,b)=>dm(b)>dm(a)?b:a),near=all.reduce((a,b)=>km(b)<km(a)?b:a),haz=all.filter(o=>o.is_potentially_hazardous_asteroid).length;
      N.neo={head:"near-Earth asteroids",text:"NASA tracked "+all.length+" near-Earth asteroids in the past week, and "+haz+(haz===1?" was":" were")+" flagged potentially hazardous. The largest, "+big.name+", is up to about "+Math.round(dm(big))+" m wide, and the closest ("+near.name+") passed about "+Math.round(km(near)).toLocaleString()+" km from Earth. Spotting hazards early gives crews time to prepare.",src:"api.nasa.gov · NeoWs"}}}catch(e){}
  try{const fl=Array.isArray(v(flr))?v(flr):[],gs=Array.isArray(v(gst))?v(gst):[];
    if(fl.length||gs.length){const top=fl.reduce((a,b)=>frank(b.classType)>frank(a.classType)?b:a,{classType:""}),kp=Math.max(0,...gs.flatMap(g=>(g.allKpIndex||[]).map(k=>+(k.kpIndex!==undefined?k.kpIndex:k.KpIndex)||0)));
      N.sun={head:"space weather",text:"In the past 30 days NASA logged "+fl.length+" solar flares"+(top.classType?" (strongest: class "+top.classType+")":"")+" and "+gs.length+" geomagnetic storm"+(gs.length===1?"":"s")+(kp?" (peak Kp "+kp+")":"")+". Space weather can disturb power systems and radio links, so crews watch it closely.",src:"api.nasa.gov · DONKI"}}}catch(e){}
  try{const a=v(apod);
    if(a&&a.title)N.apod={head:"Astronomy Picture of the Day",text:a.title+". "+String(a.explanation||"").split(". ").slice(0,2).join(". "),img:a.media_type==="image"?a.url:a.thumbnail_url,alt:a.title,src:"api.nasa.gov · APOD ("+a.date+")"}}catch(e){}
  NASA=N;
  render();
}
function endHTML(){
  const w=S.winner,multi=S.teams.length>1,sc=t=>RES.reduce((a,[k])=>a+t.r[k],0);
  const head=w!==null?(multi?(S.tie?"It’s a tie! Both teams survived 30 days with the same score.":S.teams.filter(x=>x.done).length>1?S.teams[w].name+" wins on score! Both teams survived 30 days.":S.teams[w].name+" survived 30 days first!"):"Mission complete! You survived 30 days."):(multi?"No team survived.":"Mission failed.");
  return '<h2>'+head+'</h2><ul>'+S.teams.map((t,i)=>'<li style="--tc:'+TC[i]+'"><b>'+t.name+'</b> · '+(t.out?'out on day '+t.day+' ('+t.why+')':'day '+t.day+' of 30')+' · score '+sc(t)+' ('+Math.round(100*sc(t)/(6*t.max))+'% of max)</li>').join('')+'</ul><button class="primary" id="endNew">New mission</button>';
}
function render(){
  if(!S.started)return;
  const t=T(),ph=S.mode==="phys",me=t.pos[t.mi];
  $("modelbl").textContent="Mars Madness · "+MODES.find(m=>m[0]===S.mode)[1];
  $("dayn").textContent=t.day;
  $("whose").textContent=S.teams.length>1?t.name+"’s turn":"";
  $("board").style.display=ph?"none":"block";$("entry").style.display=ph?"flex":"none";
  $("pos").textContent=(S.teams.length>1?t.name+"’s turn · ":"")+(ph?"":"Space "+cellOf(me)+(me>30?" · lap "+(Math.floor((me-1)/30)+1):"")+" · ")+(S.last?"last roll "+S.last:"no rolls yet");
  $("dief").textContent=FACES[S.last?S.last-1:0];
  $("stitle").textContent=S.title;$("smsg").textContent=S.msg;
  $("card").innerHTML=S.num?cardHTML(S.num)+lessonHTML(S.num)+nasaBox(S.num)+choiceHTML():"";
  if(!ph)$("board").innerHTML=boardHTML();
  $("psum").textContent="Cards & discards"+(S.teams.length>1?" · "+t.name:"")+" · "+(ph?"":(S.deck.length-t.dp)+" in deck · ")+t.used.length+" discarded";
  $("pbody").innerHTML=(ph?"":'<div class="pile"><div class="back">MARS</div>'+(S.deck.length-t.dp)+' left</div>')+'<div class="disc">'+(t.used.length?t.used.map(miniHTML).join(""):'No discards yet')+'</div>';
  $("ovrnote").textContent=locked()?"Locked. Resources now change only through scenario choices.":"Set starting resources before day 1. This locks once the first scenario is resolved.";
  $("teams").innerHTML=S.teams.map(teamHTML).join("");
  $("end").style.display=S.over?"flex":"none";if(S.over)$("endbox").innerHTML=endHTML();
  save();
}
function nextTurn(){
  let k=S.turn,c=0;do{k=(k+1)%S.teams.length;c++}while((S.teams[k].out||S.teams[k].done)&&c<S.teams.length);
  S.turn=k;
}
const DRAIN=2,isQ=n=>n>=19&&n<=22;
function settle(o){
  const t=T();
  if(o)RES.forEach(([key])=>{const d=o[1][key];if(d)t.r[key]=Math.max(0,Math.min(t.max,t.r[key]+d))});
  RES.forEach(([key])=>{t.r[key]=Math.max(0,t.r[key]-DRAIN)});
  t.day++;t.used.push(S.num);S.picked=true;
  S.outcome=(o?(S.teams.length>1?t.name+' chose ':'You chose ')+'“'+o[0]+'”: '+fx(o[1])+' · ':'A quiet day: no decisions to make. ')+'Daily use: −'+DRAIN+' of every resource.';
  const z=RES.find(([key])=>t.r[key]===0);
  if(z){t.out=true;t.why=z[1]+" ran out"}
  if(!t.out&&t.day>=30)t.done=true;
  const sc=x=>RES.reduce((a,[k])=>a+x.r[k],0)/(6*x.max),fin=S.teams.map((x,i)=>i).filter(i=>S.teams[i].done);
  if(S.teams.every(x=>x.out))S.over=true;
  else if(fin.length&&!S.teams.some((x,i)=>i>S.turn&&!x.out&&!x.done))S.over=true;
  if(S.over&&fin.length){const top=Math.max(...fin.map(i=>sc(S.teams[i])));const ws=fin.filter(i=>sc(S.teams[i])===top);S.winner=ws[0];S.tie=ws.length>1}
  if(!S.over)nextTurn();
  S.msg=(t.out?t.name+" is out: "+t.why+". ":t.done?t.name+" survived 30 days! ":"Day complete. ")+(S.over?"":(S.teams.length>1?T().name+" is up: roll the die.":"Roll the die for your next turn."));
}
function choose(k){
  if(!S.num||S.picked||S.over||isQ(S.num))return;
  settle(CHOICES[ix(S.num)][k]);render();
}
function draw(t){const i=S.deck[t.dp];t.dp++;S.num=i+1;S.picked=false;S.outcome="";if(isQ(S.num))settle(null)}
let rolling=false;
$("rollBtn").onclick=()=>{
  if(rolling||S.over||!S.started)return;
  if(S.num&&!S.picked){S.msg="Choose an option for the current scenario first.";render();return}
  rolling=true;
  const iv=setInterval(()=>{$("dief").textContent=FACES[Math.floor(Math.random()*6)]},70);
  setTimeout(()=>{clearInterval(iv);rolling=false;
    const t=T(),n=1+Math.floor(Math.random()*6),ph=S.mode==="phys";
    S.last=n;t.pos[t.mi]+=n;S.num=0;
    S.title=(S.teams.length>1?t.name+" rolled a ":"You rolled a ")+n;
    if(ph)S.msg="Move "+n+" space"+(n>1?"s":"")+" on your board, then enter the number on the card you draw.";
    else{S.msg="Move "+n+" space"+(n>1?"s":"")+" to space "+cellOf(t.pos[t.mi])+". A card was drawn from the deck.";draw(t)}
    render()},700);
};
function play(raw){
  if(S.over||S.mode!=="phys")return;
  const t=T(),m=String(raw||"").match(/\d+/),n=m?parseInt(m[0],10):0;
  if(n<1||n>30){S.num=0;S.title="Unknown card";S.msg="Enter a card number from 1 to 30.";render();return}
  if(t.used.includes(n)){S.num=0;S.title="Card already used!";S.msg="Card "+n+" was already played by "+t.name+".";render();return}
  S.num=n;S.picked=false;S.outcome="";S.title="Card "+n;S.msg="Read the scenario, then choose how your crew responds.";if(isQ(n))settle(null);render();
}
$("goBtn").onclick=()=>{play($("code").value);$("code").value=""};
$("code").addEventListener("keydown",e=>{if(e.key==="Enter")$("goBtn").click()});
$("card").addEventListener("click",e=>{const b=e.target.closest("[data-c]");if(b)choose(+b.dataset.c)});
$("teams").addEventListener("click",e=>{
  const b=e.target.closest("button[data-d]");if(!b||locked()||S.over)return;
  const t=S.teams[+b.dataset.t],k=b.dataset.k;
  t.r[k]=Math.max(0,Math.min(t.max,t.r[k]+ +b.dataset.d));render();
});
/* title screen, start and reset */
function renderTitle(){
  $("modes").innerHTML=MODES.map(([m,n,d])=>'<button class="mode" data-m="'+m+'" aria-pressed="'+(S.pick===m)+'"><b>'+n+'</b><span>'+d+'</span></button>').join("");
  let h="";
  if(S.pick==="phys"||S.pick==="online"){const s=S.setup;
    h='<div class="setup"><div class="srow"><span>Teams</span>'+[1,2].map(n=>'<button data-nt="'+n+'" aria-pressed="'+(s.nt===n)+'">'+n+'</button>').join("")+'</div>';
    for(let i=0;i<s.nt;i++)h+='<div class="srow"><span style="color:'+TC[i]+'">'+NAMES[i]+' members</span>'+[1,2,3].map(n=>'<button data-sz="'+i+':'+n+'" aria-pressed="'+(s.sizes[i]===n)+'">'+n+'</button>').join("")+'<em>starts at '+(100+20*(s.sizes[i]-1))+' per resource</em></div>';
    h+='<p>Each member beyond the first adds +20 to every resource’s starting level and maximum.</p></div>';
  }
  $("setup").innerHTML=h;
  $("startBtn").disabled=!S.pick;
  $("contBtn").style.display=(S.started&&!S.over)?"block":"none";
}
$("titlescreen").addEventListener("click",e=>{
  const b=e.target.closest("button");if(!b)return;
  if(b.dataset.m)S.pick=b.dataset.m;
  else if(b.dataset.nt)S.setup.nt=+b.dataset.nt;
  else if(b.dataset.sz){const [i,n]=b.dataset.sz.split(":");S.setup.sizes[+i]=+n}
  else return;
  renderTitle();
});
const showPlay=()=>{$("titlescreen").style.display="none";$("play").style.display="block";window.scrollTo(0,0)};
$("startBtn").onclick=()=>{
  if(!S.pick)return;
  const solo=S.pick==="solo",nt=solo?1:S.setup.nt;
  S.mode=S.pick;
  S.teams=Array.from({length:nt},(_,i)=>{const size=solo?1:S.setup.sizes[i],max=100+20*(size-1),r={};RES.forEach(([k])=>r[k]=max);
    return {name:solo?"Solo crew":NAMES[i],size,max,r,day:0,used:[],dp:0,pos:[0],mi:0,out:false,done:false,why:""}});
  S.deck=shuffle(Array.from({length:30},(_,i)=>i));
  S.turn=0;S.started=true;S.over=false;S.winner=null;S.num=0;S.picked=true;S.last=0;S.outcome="";
  S.title="Mission start";
  S.msg=S.mode==="phys"?"Roll the die, move, then enter the number on the card you draw.":"Roll the die. Your piece moves and a card is drawn automatically.";
  showPlay();render();
};
$("contBtn").onclick=()=>{showPlay();render()};
function hardReset(){
  S=Object.assign(fresh(),{setup:S.setup});
  rt=0;$("resetBtn").textContent="New mission";
  $("end").style.display="none";$("play").style.display="none";$("titlescreen").style.display="";
  renderTitle();save();window.scrollTo(0,0);
}
let rt=0;
$("resetBtn").onclick=()=>{
  if(rt){clearTimeout(rt);hardReset();return}
  $("resetBtn").textContent="Tap again to confirm: this clears the game";
  rt=setTimeout(()=>{rt=0;$("resetBtn").textContent="New mission"},4000);
};
$("end").addEventListener("click",e=>{if(e.target.id==="endNew")hardReset()});
renderTitle();loadNasa();
</script>

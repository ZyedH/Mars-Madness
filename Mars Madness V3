:root[data-theme="dark"]{--bg:#17110e;--panel:#241b16;--ink:#f1e5d6;--mute:#a8917f;--line:#3a2c24;--ok:#5fd0a8;--warn:#f2a93b;--bad:#ff6b57;--btn:#f1e5d6;--btnink:#17110e}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 "IBM Plex Sans",system-ui,sans-serif}
main{max-width:960px;margin:0 auto;padding:16px}
h1,h2,h3,.num{font-family:"Chakra Petch","Arial Narrow",sans-serif}
header{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:12px}
header h1{font-size:15px;margin:0 0 4px;color:var(--mute);font-weight:600}
.day{font:700 56px/1 "Chakra Petch",sans-serif;letter-spacing:-1px}.day small{font-size:20px;color:var(--mute);font-weight:600;letter-spacing:0}
#whose{font-size:18px;color:var(--mute);text-align:right}
button{font:inherit;cursor:pointer;border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:10px;padding:10px 12px;min-height:44px}
button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid var(--warn);outline-offset:2px}
button:disabled{opacity:.4;cursor:not-allowed}
.primary{background:var(--btn);color:var(--btnink);border-color:var(--btn);font-weight:600;width:100%;font-size:18px}
.ts{min-height:80vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:14px}
.ts h1{font:700 clamp(52px,17vw,100px)/.95 "Chakra Petch",sans-serif;margin:0;letter-spacing:-2px}
.ts>p{font-size:19px;color:var(--mute);margin:0;max-width:30ch}
.planet{width:88px;height:88px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e8955f,#b0472b 58%,#5b2314)}
.modes{display:grid;gap:8px;width:100%;max-width:420px}
.mode{text-align:left;padding:12px 14px}.mode b{display:block;font:700 18px "Chakra Petch",sans-serif}.mode span{color:var(--mute);font-size:14px}
.mode[aria-pressed=true]{background:var(--btn);color:var(--btnink)}.mode[aria-pressed=true] span{color:inherit;opacity:.8}
.setup{width:100%;max-width:420px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px}
.srow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;font-weight:600}.srow>span{min-width:120px}.srow em{color:var(--mute);font-size:13px;font-style:normal;font-weight:400}
.srow button{min-width:44px}.srow button[aria-pressed=true]{background:var(--btn);color:var(--btnink)}
.ts .setup p{font-size:14px;max-width:none;margin:0;color:var(--mute)}
#startBtn,#contBtn{max-width:420px}
.die{display:flex;gap:14px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:12px}.die>div:last-child{flex:1}.dief{font-size:76px;line-height:1;min-width:84px;text-align:center}#pos{color:var(--mute);margin-top:6px;font-size:14px}
.start{display:flex;align-items:center;gap:6px;min-height:34px;padding:4px 8px;margin-bottom:6px;background:var(--panel);border:1px dashed var(--line);border-radius:10px;font:700 14px "Chakra Petch",sans-serif}
.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:4px;max-width:640px}
.cell{aspect-ratio:1;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:3px;display:flex;flex-wrap:wrap;align-content:flex-end;gap:2px;position:relative}
.cell i{position:absolute;top:3px;left:5px;font:600 11px "IBM Plex Sans",sans-serif;font-style:normal;color:var(--mute)}
.tok{width:20px;height:20px;border-radius:50%;color:#fff;font:700 12px/20px "Chakra Petch",sans-serif;text-align:center;box-shadow:0 0 0 2px var(--panel)}.tok.on{box-shadow:0 0 0 2px var(--ink)}
#board{margin-bottom:12px}
.manual{display:flex;gap:8px;margin-bottom:12px}.manual input{flex:1;min-width:0;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--ink)}
.status{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:12px}.status b{display:block;font:700 20px/1.2 "Chakra Petch",sans-serif}.status span{color:var(--mute);font-size:14px}
.card{border:3px solid var(--c);border-radius:16px;background:var(--panel);overflow:hidden;max-width:380px;margin:0 0 12px}
.ctop{background:var(--c);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:8px 14px}.cn{font:700 20px "Chakra Petch",sans-serif}.ci{font-size:46px;line-height:1}
.cb{padding:12px 14px}.cb h3{margin:0 0 6px;font-size:20px;color:var(--c)}.cb p{margin:0}
.lesson{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}.lesson h3{margin:0 0 4px;font-size:16px}.lesson p{margin:0}
.choice{display:block;width:100%;text-align:left;margin-top:8px;font-weight:600}.choice small{display:block;color:var(--mute);font-weight:500;margin-top:2px}.outcome{margin-top:12px;padding:10px;border-radius:10px;background:var(--panel);border:1px solid var(--line);font-weight:600}
.piles{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin:12px 0}.piles summary{cursor:pointer;font-weight:600;min-height:32px;display:flex;align-items:center}
#pbody{display:flex;gap:12px;align-items:flex-start;margin-top:8px}
.pile{text-align:center;font-size:13px;color:var(--mute)}.back{width:64px;height:92px;border-radius:8px;background:var(--ink);display:grid;place-items:center;color:var(--bg);font:700 11px "Chakra Petch",sans-serif;letter-spacing:1px;margin-bottom:4px}
.disc{display:flex;flex-wrap:wrap;gap:6px;color:var(--mute);font-size:14px}
.mini{width:42px;height:60px;border-radius:6px;border:2px solid var(--c);background:var(--panel);display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:2px;font-size:11px}.mini b{background:var(--c);color:#fff;width:100%;text-align:center;border-radius:3px}.mini span{font-size:20px}
.ovr h2{font-size:20px;margin:14px 0 2px}.ovr p{margin:0 0 10px;color:var(--mute);font-size:14px}
.teams{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
.team{background:var(--panel);border:1px solid var(--line);border-top:5px solid var(--tc);border-radius:12px;padding:12px}.team.act{outline:2px solid var(--tc)}.team.out{opacity:.6}
.th{display:flex;justify-content:space-between;align-items:baseline;gap:8px}.th h2{margin:0;font-size:20px;color:var(--tc)}.th span{font-size:13px;color:var(--mute)}
.track{height:6px;background:var(--line);border-radius:3px;margin:8px 0;overflow:hidden}.track i{display:block;height:100%;background:var(--tc)}
.rr{margin-bottom:10px}.rl{display:flex;justify-content:space-between;font-size:15px}
.bar{height:10px;background:var(--line);border-radius:5px;margin:4px 0;overflow:hidden}.bar i{display:block;height:100%;background:var(--ok);transition:width .25s}.low .bar i{background:var(--bad)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}.steps button{padding:4px;min-height:34px;font-weight:600}
.warn{font-weight:600;color:var(--bad);font-size:13px}
.reset{margin-top:16px;width:100%;color:var(--mute)}
.nasa{margin-top:12px;padding:10px 12px;border-left:4px solid var(--ok);background:var(--bg);border-radius:6px}.nasa h3{margin:0 0 4px;font-size:15px}.nasa p{margin:0 0 4px}.nasa small{color:var(--mute)}.nasa img{max-width:100%;border-radius:8px;margin-top:6px}
.end{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;padding:16px;z-index:20}
.endbox{background:var(--panel);color:var(--ink);border-radius:16px;padding:20px;max-width:440px;width:100%}.endbox h2{margin:0 0 10px;font-size:28px;line-height:1.1}
.endbox ul{list-style:none;padding:0;margin:0 0 16px}.endbox li{border-left:5px solid var(--tc);padding:6px 10px;margin-bottom:6px;background:var(--bg);border-radius:6px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
